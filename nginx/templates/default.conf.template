upstream django {
    server web:8000;
}

# Only the unexposed tunnel listener consumes Cloudflare's client metadata.
map $http_cf_connecting_ip $tunnel_client_ip {
    default $http_cf_connecting_ip;
    '' $remote_addr;
}
map $http_x_forwarded_proto $tunnel_proto {
    default http;
    https https;
}

# Öffentlicher HTTP-Eingang: fremde Proxy-Header werden nicht vertraut.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    client_max_body_size 25M;

    # Let's Encrypt ACME Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Statische Assets (CSS, JS, Fonts)
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        gzip_static on;
    }

    # Uploads (Logos, User-Bilder)
    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    # Backups are streamed to disk; larger uploads are permitted only on admin backup routes.
    location ^~ /admin/backups/ {
        client_max_body_size 1024M;
        client_body_timeout 300s;
        if ($scheme = http) {
            return 301 https://$host$request_uri;
        }
        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 300s;
    }

    # Anfragen weiterleiten
    location / {
        # Öffentliche HTTP-Anfragen immer auf HTTPS umleiten
        if ($scheme = http) {
            return 301 https://$host$request_uri;
        }

        # Weiterleitung an Gunicorn
        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# Interner Tunnel-Eingang: Port 8080 wird nicht am Host veröffentlicht.
server {
    listen 8080;
    listen [::]:8080;
    server_name ${DOMAIN_NAME};

    client_max_body_size 25M;

    # Let's Encrypt ACME Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Statische Assets (CSS, JS, Fonts)
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        gzip_static on;
    }

    # Uploads (Logos, User-Bilder)
    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    # Backups are streamed to disk; larger uploads are permitted only on admin backup routes.
    location ^~ /admin/backups/ {
        client_max_body_size 1024M;
        client_body_timeout 300s;

        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $tunnel_client_ip;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $tunnel_client_ip;
        proxy_set_header X-Forwarded-Proto $tunnel_proto;
        proxy_redirect off;
        proxy_read_timeout 300s;
    }

    # Anfragen weiterleiten
    location / {
        # Öffentliche HTTP-Anfragen immer auf HTTPS umleiten


        # Weiterleitung an Gunicorn
        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $tunnel_client_ip;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $tunnel_client_ip;
        proxy_set_header X-Forwarded-Proto $tunnel_proto;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# HTTPS Server: Direkter SSL-Betrieb für reguläre VPS (Let's Encrypt)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384";
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 25M;

    # Statische Assets (CSS, JS, Fonts)
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        gzip_static on;
    }

    # Uploads (Logos, User-Bilder)
    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Reverse Proxy zu Gunicorn
    location ^~ /admin/backups/ {
        client_max_body_size 1024M;
        client_body_timeout 300s;
        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }
}
