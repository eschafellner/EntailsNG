upstream django {
    server web:8000;
}

# Bestimme das reale Protokoll (HTTPS oder HTTP):
# Falls ein Proxy wie Cloudflare Tunnel bereits "https" gemeldet hat, übernehmen wir das.
# Andernfalls nutzen wir das lokale Verbindungsprotokoll ($scheme).
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Bestimme die echte Client-IP (Cloudflare Edge liefert CF-Connecting-IP):
map $http_cf_connecting_ip $real_client_ip {
    default $http_cf_connecting_ip;
    ''      $remote_addr;
}

# Prüfe, ob eine Weiterleitung von Port 80 auf HTTPS erforderlich ist:
# 1 = Ja (klassischer Browseraufruf per unverschlüsseltem HTTP auf einem VPS)
# 0 = Nein (bereits über HTTPS/Cloudflare Tunnel oder interne Healthchecks)
map $http_x_forwarded_proto $redirect_to_https {
    default 0;
    ''      1;
    http    1;
}

# HTTP Server: ACME-Challenge für Let's Encrypt + Cloudflare Tunnel Support
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    client_max_body_size 25M;

    # Let's Encrypt ACME Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Statische Assets (CSS, JS, Fonts)
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        gzip_static on;
    }

    # Uploads (Logos, User-Bilder)
    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    # Anfragen weiterleiten
    location / {
        # Auf einem klassischen VPS ohne HTTPS-Header: 301 Weiterleitung auf Port 443
        if ($redirect_to_https = 1) {
            return 301 https://$host$request_uri;
        }

        # Bei Cloudflare Tunnel oder bereits aktivem HTTPS: Direkt zu Gunicorn durchleiten
        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# HTTPS Server: Direkter SSL-Betrieb für reguläre VPS (Let's Encrypt)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384";
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 25M;

    # Statische Assets (CSS, JS, Fonts)
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        gzip_static on;
    }

    # Uploads (Logos, User-Bilder)
    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Reverse Proxy zu Gunicorn
    location / {
        proxy_pass http://django;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }
}
