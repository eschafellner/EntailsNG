# EntailsNG Database Configuration
DB_ENGINE=postgresql
DB_NAME=entailsng_db
DB_USER=entailsng
DB_PASSWORD=change-this-to-a-secure-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Production Security
# WICHTIG: Setze in Produktion unbedingt einen sicheren, zufälligen SECRET_KEY!
SECRET_KEY=change-me-in-production-secret-key-12345
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,lan.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://lan.example.com
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Cache (Optional: Redis URL, z. B. redis://127.0.0.1:6379/1)
# REDIS_URL=redis://127.0.0.1:6379/1

