# ==============================================================================
# EntailsNG - Produktions-Umgebungsvariablen (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Basis-Sicherheit & Domain (PFLICHT)
# ------------------------------------------------------------------------------
# Generiere einen kryptografisch sicheren Schlüssel (z. B. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=hier-einen-langen-zufaelligen-secret-key-eintragen

# Schlüssel zur Verschlüsselung von Zugangsdaten in der Datenbank
# (z. B. das SMTP-Passwort aus dem Admin-Backend).
# Generieren: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
# EINMAL SETZEN UND NIE ÄNDERN. Nach einer Änderung müssen alle im Backend
# gespeicherten Passwörter neu eingegeben werden. Bewusst getrennt vom
# SECRET_KEY, damit dieser gefahrlos rotiert werden kann.
FIELD_ENCRYPTION_KEY=hier-einen-langen-zufaelligen-schluessel-eintragen

# Im Produktivbetrieb zwingend False!
DEBUG=False

# Deine Domain(s) kommagetrennt (z. B. lan.meinedomain.de)
ALLOWED_HOSTS=lan.meinedomain.de

# Vertrauenswürdige HTTPS-Origins für CSRF-Schutz
CSRF_TRUSTED_ORIGINS=https://lan.meinedomain.de

# Domainname für Nginx und automatische Let's Encrypt Zertifikate
DOMAIN_NAME=lan.meinedomain.de

# E-Mail-Adresse für Let's Encrypt Ablauf-Benachrichtigungen
CERTBOT_EMAIL=admin@meinedomain.de


# ------------------------------------------------------------------------------
# 2. PostgreSQL Datenbank-Konfiguration (PFLICHT)
# ------------------------------------------------------------------------------
DB_ENGINE=postgresql
DB_NAME=entailsng_db
DB_USER=entailsng_user
DB_PASSWORD=hier-ein-sicheres-datenbank-passwort-eintragen
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600


# ------------------------------------------------------------------------------
# 3. Redis Cache-Konfiguration (PFLICHT für Multi-Worker Betrieb)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1


# ------------------------------------------------------------------------------
# 4. E-Mail-Konfiguration (Standard SMTP)
# ------------------------------------------------------------------------------
# Backend für den Mailversand:
# ConfiguredSMTPBackend liest Absender, Testmodus und ggf. eigene
# SMTP-Zugangsdaten dynamisch aus dem Admin-Backend (Allgemeine E-Mail Einstellungen).
# Die folgenden EMAIL_*-Werte dienen als Servervorgabe, falls im Backend
# "Vom Server vorgegeben (.env)" gewählt ist.
EMAIL_BACKEND=emails.backends.ConfiguredSMTPBackend
EMAIL_HOST=smtp.dein-email-anbieter.de
EMAIL_PORT=587
EMAIL_HOST_USER=dein-smtp-benutzername
EMAIL_HOST_PASSWORD=dein-smtp-passwort
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL dient als Fallback, wird aber durch die Absenderadresse aus dem Backend überschrieben
DEFAULT_FROM_EMAIL=noreply@meinedomain.de
SERVER_EMAIL=noreply@meinedomain.de
EMAIL_TIMEOUT=10


# ------------------------------------------------------------------------------
# 5. HTTPS & Reverse Proxy Security Header (Produktion)
# ------------------------------------------------------------------------------
BEHIND_PROXY=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True


# ------------------------------------------------------------------------------
# 6. Logging & Diagnose
# ------------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO


